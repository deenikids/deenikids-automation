  "category": "islamic_songs",
  "title_en": "Bismillah Before We Begin",
  "title_hi": "Bismillah Se Shuru Karein",
  "lesson": "Say Bismillah before eating and Alhamdulillah after eating.",
  "tempo_bpm": 108,
  "key": "C major",
  "time_signature": "4/4",
  "target_duration_sec": [70, 85],

  "religious_sources": [
    {
      "claim": "Say Bismillah (mention Allah's name) before eating; eat with the right hand.",
      "reference": "Sahih al-Bukhari 5376; Sahih Muslim 2022",
      "url": "https://sunnah.com/bukhari:5376",
      "note": "The Prophet (peace be upon him) taught this to a young boy, Umar ibn Abi Salamah, so it is a natural lesson for children."
    },
    {
      "claim": "Praise Allah (Alhamdulillah) after eating and drinking.",
      "reference": "Sahih Muslim 2734",
      "url": "https://sunnah.com/muslim:2734",
      "note": "Allah is pleased with the servant who eats and praises Him for it."
    }
  ],

  "review": {
    "religious": {"status": "pending", "reviewer": "", "date": "", "notes": "An alim or qualified teacher must sign off before public upload."},
    "english_lyrics": {"status": "pending", "reviewer": "", "date": "", "notes": "Outro lines 3-4 changed for rhyme; original kept below."},
    "hinglish_lyrics": {"status": "pending", "reviewer": "", "date": "", "notes": "Native Hindi/Urdu speaker to check flow and wording."}
