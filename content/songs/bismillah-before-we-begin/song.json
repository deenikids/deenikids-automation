  "lyric_changes": [
    {
      "where": "Outro, lines 3-4",
      "original": "Alhamdulillah after our meal, / Thank You, Allah, for food so good!",
      "proposed": "Alhamdulillah when we're through, / Thank You, Allah, the food's from You!",
      "reason": "'meal' and 'good' do not rhyme; the new lines rhyme and teach that our food is a gift from Allah. Revert if you prefer the original."
    }
  ],

